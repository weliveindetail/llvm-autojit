#!/usr/bin/env bash

clang="@AUTOJIT_BENCH_TOOLS_DIR@/clang"
CFLAGS="-O0 -g -fpass-plugin=@CMAKE_INSTALL_PREFIX@/lib/autojit.so"

if [ "$AUTOJIT_LINK_STATIC_RUNTIME" = "On" ]; then
  LDFLAGS="-L@CMAKE_INSTALL_PREFIX@/lib -lautojit_static_ldscript"
else
  LDFLAGS="-Wl,-rpath=@CMAKE_INSTALL_PREFIX@/lib -L@CMAKE_INSTALL_PREFIX@/lib -lautojit-runtime"
fi

LDFLAGS="$LDFLAGS -fuse-ld=lld"

# Keep lazy modules in the build tree, /tmp is shared with all other builds
export AUTOJIT_DIR="$(pwd)/bzip2/$AUTOJIT_BUILD_DIR/autojit"

cd bzip2/$AUTOJIT_BUILD_DIR
make CC="$clang" CXX="$clang++" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
